# Copy to apps/admin/.env.local. All values are server only.
# At least 32 random bytes.
WIDGET_TOKEN_SECRET=
# From `corepack pnpm exec supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Answers (Claude Haiku 5.5) and embeddings (text-embedding-3-small).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Set to "fake" for canned answers without API calls (E2E does this).
LLM_MODE=
