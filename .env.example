# Copy to apps/admin/.env.local. All values are server only.
# At least 32 random bytes.
WIDGET_TOKEN_SECRET=
# From `corepack pnpm exec supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Answers (Claude Haiku 5.5) and embeddings (text-embedding-3-small).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Set to "fake" for canned answers without API calls (E2E does this).
LLM_MODE=
# Inquiry alerts. Without a key, alerts are skipped and inquiries still save.
RESEND_API_KEY=
# Sender; needs a domain verified in Resend except for Resend's own test address.
RESEND_FROM=SupportKit <onboarding@resend.dev>
# Recipient for bots without an owner (the local demo bot). Owned bots use the owner's email.
INQUIRY_NOTIFY_EMAIL=

